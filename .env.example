# Copy to .env at the project root. Never commit the real key.
BCRAG_HOST=127.0.0.1
BCRAG_PORT=8000
BCRAG_DATA_DIR=./data
# Alibaba Cloud Model Studio: use a Beijing-region pay-as-you-go API key
# with the matching Beijing endpoint. Other OpenAI-compatible providers work
# when they support both /chat/completions and /embeddings.
BCRAG_API_KEY=
BCRAG_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BCRAG_CHAT_MODEL=qwen3.7-flash
BCRAG_EMBED_MODEL=text-embedding-v4
BCRAG_EMBED_DIMENSIONS=256
BCRAG_DAILY_CHAT_LIMIT=40
BCRAG_GLOBAL_DAILY_CHAT_LIMIT=200
BCRAG_MAX_USERS=100
BCRAG_MAX_DOCUMENT_BYTES=20971520
